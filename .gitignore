# Consolidated .gitignore for Project File (PDF Workspace)

# Dependencies & Build Output
node_modules/
pdf-workspace-frontend/node_modules/
pdf-workspace-frontend/dist/
pdf-workspace-frontend/dist-ssr/
pdf-workspace-backend/target/
*.jar
*.war

# Environment Variables & Secrets
.env
.env.local
.env.*.local
pdf-workspace-frontend/.env
pdf-workspace-backend/.env

# Temp Files & Storage
pdf-workspace-temp/
temp/
tmp/
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
logs/

# IDE & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.iws
*.iml
*.ipr
