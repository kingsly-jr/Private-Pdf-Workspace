# Consolidated .gitignore for Project File (PDF Workspace)

# Dependencies & Build Output
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
backend/target/
target/
*.jar
*.war

# Environment Variables & Secrets
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# Temp Files & Storage
pdf-workspace-temp/
temp/
tmp/
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
logs/

# IDE & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.iws
*.iml
*.ipr
